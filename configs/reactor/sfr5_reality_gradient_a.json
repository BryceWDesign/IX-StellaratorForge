      "authority": "optimization_degree_of_freedom_only"
    },
    {
      "group": "winding_surface",
      "variables": ["surface_Fourier_coefficients", "offset_or_clearance_distribution", "maintenance_exclusion_zones"],
      "authority": "optimization_degree_of_freedom_only"
    },
    {
      "group": "coil_geometry",
