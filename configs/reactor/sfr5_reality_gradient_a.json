    }
  ],
  "required_external_methods": [
    {
      "stage": "winding_surface_feasibility",
      "preferred_methods": ["QUADCOIL_or_equivalent_differentiable_winding_surface_optimizer"],
      "required_outputs": ["normal_field_error", "curvature_or_complexity_constraints", "force_or_support_proxy", "plasma_and_winding_surface_sensitivities"]
    },
    {
      "stage": "discrete_nonplanar_coils",
      "preferred_methods": ["SIMSOPT_or_equivalent_constrained_filament_optimizer"],
      "required_outputs": ["coil_curves", "currents", "quadratic_flux", "length", "curvature", "coil_coil_distance", "coil_plasma_distance"]
    },
    {
      "stage": "single_stage_codesign",
      "preferred_methods": ["SIMSOPT_plus_VMEC_or_DESC_equivalent"],
      "required_outputs": ["optimized_plasma_boundary", "optimized_coils", "equilibrium_receipt", "objective_and_constraint_history"]
