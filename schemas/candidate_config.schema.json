{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IX-Fusion Candidate Configuration",
  "type": "object",
  "required": [
    "name", "role", "description", "nfp", "major_radius", "minor_radius",
    "axis_helical_amplitude", "iota0", "shear", "mirror_amplitude",
    "required_helical_strength", "harmonics"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "role": {"enum": ["candidate", "matched_baseline", "negative_control", "ablation"]},
    "description": {"type": "string", "minLength": 1},
    "nfp": {"type": "integer", "minimum": 1, "maximum": 12},
    "major_radius": {"type": "number", "exclusiveMinimum": 0},
    "minor_radius": {"type": "number", "exclusiveMinimum": 0},
    "axis_helical_amplitude": {"type": "number", "minimum": 0},
    "iota0": {"type": "number"},
    "shear": {"type": "number"},
    "mirror_amplitude": {"type": "number", "minimum": 0},
    "required_helical_strength": {"type": "number", "minimum": 0},
    "harmonics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["m", "n", "amplitude"],
        "properties": {
          "m": {"type": "integer", "minimum": 1},
          "n": {"type": "integer", "minimum": 0},
          "amplitude": {"type": "number"},
          "phase": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"}
  }
}
